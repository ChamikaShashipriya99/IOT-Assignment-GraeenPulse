{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:us-east-1:ACCOUNT_ID:client/greenpulse_backend"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topicfilter/greenpulse/sensors",
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topicfilter/greenpulse/status"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topic/greenpulse/sensors",
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topic/greenpulse/status"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topic/greenpulse/ai/care",
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topic/greenpulse/ai/weather",
        "arn:aws:iot:us-east-1:ACCOUNT_ID:topic/greenpulse/ai/notifications"
      ]
    }
  ]
}
