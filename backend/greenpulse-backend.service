[Unit]
Description=GreenPulse cloud backend
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/IOT-Assignment-GraeenPulse/backend
ExecStart=/home/ubuntu/IOT-Assignment-GraeenPulse/backend/venv/bin/python main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
