AWS_REGION=us-east-1
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
IOT_PORT=8883
IOT_CLIENT_ID=greenpulse_backend
ROOT_CA_PATH=certs/AmazonRootCA1.pem
CERT_PATH=certs/backend-certificate.pem.crt
KEY_PATH=certs/backend-private.pem.key

ALLOWED_DEVICES=greenpulse_01
PLANT_TYPE=chili plant

SAVE_TO_DYNAMODB=true
DYNAMODB_TABLE=greenpulse_sensor_data
DATA_RETENTION_DAYS=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

WEATHER_API_KEY=
WEATHER_LAT=6.9147
WEATHER_LON=79.9729
WEATHER_MAX_AGE_MINUTES=60

EMAIL_ENABLED=true
EMAIL_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_DAYS=3
EMAIL_MAX_CHECK=30
EMAIL_MAX_RELEVANT=5

CARE_INTERVAL_MINUTES=5
WEATHER_INTERVAL_MINUTES=15
EMAIL_INTERVAL_MINUTES=15
READING_MAX_AGE_MINUTES=5

LOG_FILE=logs/backend.log
